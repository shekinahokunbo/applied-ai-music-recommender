%%{init: {'theme': 'neutral'}}%%
flowchart TD
    U["User free-text request\n(CLI arg or interactive prompt)\ne.g. \"moody songs for a rainy commute,\nnot too aggressive\""]

    subgraph GUARD1["Guardrail: input validation"]
        V1{"empty / too long?"}
    end

    U --> V1
    V1 -- "empty" --> REJECT["Reject with a helpful prompt\n(no API call made)"]
    V1 -- "ok, truncate to 500 chars" --> PARSE

    subgraph AGENT["Agentic pipeline (src/ai_pipeline.py)"]
        direction TB

        PARSE["Step 1: PLAN / PARSE\nClaude (claude-haiku-4-5)\nforced JSON-schema output\nfree text -> {genre, mood, energy, likes_acoustic}"]
        FALLBACK["Fallback: offline keyword matcher\n(fallback_parse)\nused if the API call fails"]
        PARSE -. "on API error" .-> FALLBACK

        VALIDATE["Step 2: VALIDATE (guardrail)\nvalidate_profile()\nclamp energy to [0,1], sanitize types,\ndrop hallucinated fields"]
        FALLBACK --> VALIDATE
        PARSE --> VALIDATE

        RETRIEVE["Step 3: RETRIEVE\nrecommend_songs() -- the deterministic\nModule 1-3 scoring/ranking engine\nover data/songs.csv (24 songs)"]
        VALIDATE --> RETRIEVE

        CRITIQUE["Step 4: CRITIQUE\nClaude reviews its own retrieval\nagainst the original request\n-> confidence score + optional\nadjusted profile"]
        RETRIEVE --> CRITIQUE

        DECIDE{"confidence < 0.5\nAND an adjustment\nwas proposed?"}
        CRITIQUE --> DECIDE
        RERETRIEVE["Step 5: RE-RETRIEVE\nrecommend_songs() again with\nthe adjusted profile"]
        DECIDE -- yes --> RERETRIEVE
        RERETRIEVE --> EXPLAIN
        DECIDE -- no --> EXPLAIN

        EXPLAIN["Step 6: EXPLAIN (multi-source grounded generation)\nClaude writes a 2-4 sentence explanation\ngrounded ONLY in the actually-retrieved\nsongs/scores AND their curator notes\n-- baseline or DJ-persona tone"]
    end

    CATALOG[("Source A: data/songs.csv\n24 songs x 10 structured attributes")]
    NOTES[("Source B: data/song_notes.csv\nfree-text curator liner notes,\nkeyed by song id")]
    CATALOG -.-> RETRIEVE
    NOTES -. "looked up for each\nretrieved song's id" .-> EXPLAIN

    EXPLAIN --> OUT["Final output:\nranked songs + scores + reasons\n+ confidence + AI explanation"]
    REJECT --> OUT

    TRACE[("logs/agent_traces.jsonl\nfull step-by-step reasoning trace,\none JSON line per run")]
    PARSE -.-> TRACE
    VALIDATE -.-> TRACE
    RETRIEVE -.-> TRACE
    CRITIQUE -.-> TRACE
    RERETRIEVE -.-> TRACE
    EXPLAIN -.-> TRACE

    OUT --> CLI["src/ai_main.py\nprints trace + result to terminal"]

    subgraph EVAL["Reliability / evaluation harness (src/eval_ai.py)"]
        E1["7 predefined queries:\nnormal, adversarial/contradictory,\nempty input, gibberish,\nprompt-injection attempt"]
        E2["Automated checks per case:\nprofile schema valid, energy in [0,1],\n1-5 recs returned, confidence in [0,1],\nexplanation grounded in real song titles,\nno system-prompt leakage"]
        E3["Pass/fail table +\nsummary line + avg confidence"]
        E1 --> E2 --> E3
    end
    AGENT -. "same pipeline, run per test case" .-> EVAL

    style REJECT fill:#f8d7da,stroke:#c0392b
    style FALLBACK fill:#fff3cd,stroke:#b7891c
    style GUARD1 fill:#fdecea,stroke:#c0392b
    style EVAL fill:#e8f4fd,stroke:#2874a6
    style CATALOG fill:#eaf7ea,stroke:#2e7d32
    style NOTES fill:#eaf7ea,stroke:#2e7d32
    style TRACE fill:#eaf7ea,stroke:#2e7d32
